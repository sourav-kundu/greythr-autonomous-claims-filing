# =============================================================================
# GreytHR Claims Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- AI Provider Configuration ---
# Supported providers: anthropic, openai, gemini
AI_PROVIDER=anthropic

# Model to use (must match provider)
# Examples:
#   anthropic: claude-sonnet-4-20250514
#   openai: gpt-4o
#   gemini: gemini-2.0-flash
AI_MODEL=claude-sonnet-4-20250514

# API Keys (only the key for your chosen provider is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- GreytHR Configuration ---
GREYTHR_URL=https://browserstack.greythr.com

# --- WhatsApp Configuration ---
# Exact name of the WhatsApp group to listen to
WHATSAPP_GROUP_NAME=GreytHr Travel Reimbursement

# Rolling window (seconds) to wait for more messages before processing a batch.
# When invoices are sent in bulk, they may arrive one by one with small delays.
# The bot waits this many seconds after the LAST received message before processing.
BATCH_WINDOW_SECONDS=5
